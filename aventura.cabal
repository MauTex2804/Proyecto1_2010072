cabal-version:      3.0
name:               aventura
version:            0.1.0.0
build-type:         Simple

executable aventura
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Motor.Tipos
                    , Motor.Reconocedor
                    , Motor.Mundo
    build-depends:    base >=4.14 && <5
                    , containers
                    , directory
                    , filepath
    default-language: Haskell2010
